{"format_version":1,"packages":[{"archive":"codes/Zankou_Lacrimosa_Qianxia_1.0.0.zip","filename":"Zankou_Lacrimosa_Qianxia_1.0.0.zip","size":4681,"updated_at":"2026-08-30T16:27:52+08:00","format_version":1,"name":"残虹安魂曲双核社区版","description":"队伍简介：残虹安魂曲双核队由残虹、安魂曲、早雾和阿德勒组成。残虹先用重击点亮黄色技能，接紫色技能后连续释放两次终结技；安魂曲交接后完整释放技能和终结技，再补一段普通攻击；随后阿德勒优先开盾，早雾释放终结技和技能提供增益，最后回到残虹循环。两名核心轮流站场，辅助只在交接窗口提供护盾和增益。","author":"千夏叶樱","version":"1.0.0","slots":[{"index":0,"kind":"external","file":"dual_zankou.py","class_name":"DualCoreZankou","display":{"zh_CN":"残虹（安魂曲双核）","en_US":"Zankou (Lacrimosa Dual Core)"}},{"index":1,"kind":"external","file":"dual_lacrimosa.py","class_name":"DualCoreLacrimosa","display":{"zh_CN":"安魂曲（残虹双核）","en_US":"Lacrimosa (Zankou Dual Core)"}},{"index":2,"kind":"builtin","impl_id":"builtin:sakiri","display":{"zh_CN":"早雾","en_US":"Sakiri"}},{"index":3,"kind":"builtin","impl_id":"builtin:adler","display":{"zh_CN":"阿德勒","en_US":"Adler"}}]},{"archive":"codes/Zankou_Community_BnanZ0_1.0.1.zip","filename":"Zankou_Community_BnanZ0_1.0.1.zip","size":4221,"updated_at":"2026-08-30T16:14:21+08:00","format_version":1,"name":"残虹倾陷社区版","description":"残虹倾陷队：达芙蒂尔先重击充能首个 Q，亮起后立即释放；阿德勒优先开盾，伊洛伊用 E/Q 提供治疗与增益并快速离场；最后由残虹长按重击点亮黄 E，接紫 E 后连续释放两次 Q，循环中保持残虹站场输出。","author":"千夏叶樱","version":"1.0.1","slots":[{"index":0,"kind":"external","file":"zankou.py","class_name":"CommunityZankou","display":{"zh_CN":"残虹（社区版）","en_US":"Zankou (Community)"}},{"index":1,"kind":"external","file":"daffodill.py","class_name":"CommunityDaffodill","display":{"zh_CN":"达芙蒂尔（社区版）","en_US":"Daffodill (Community)"}},{"index":2,"kind":"external","file":"iroi.py","class_name":"CommunityIroi","display":{"zh_CN":"伊洛伊（社区版）","en_US":"Iroi (Community)"}},{"index":3,"kind":"external","file":"adler.py","class_name":"CommunityAdler","display":{"zh_CN":"阿德勒（社区版）","en_US":"Adler (Community)"}}]},{"archive":"codes/Zankou_Community_BnanZ0_1.0.0.zip","filename":"Zankou_Community_BnanZ0_1.0.0.zip","size":4212,"updated_at":"2026-08-30T16:14:21+